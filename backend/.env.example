# Copy this file to ".env" in the backend folder and fill in your values.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=4000
DB_NAME=customer_database
DB_SSL=true

# Required. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Only when running behind your own reverse proxy:
# TRUST_PROXY=true
