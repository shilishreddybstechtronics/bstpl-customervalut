# Copy this file to backend/.env (the name must be exactly ".env"). Never commit .env.
# This file holds PLACEHOLDERS only - never put a real password in it.

# ---- A) While running migrate_to_tidb.py: the SOURCE is your LOCAL MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_local_mysql_password
MYSQL_DATABASE=cs

# ---- B) Afterwards, to run the site on your computer against TiDB Cloud ----
# (replace block A with this block; on Render these go in the Environment tab, not in a file)
# MYSQL_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# MYSQL_PORT=4000
# MYSQL_USER=3A7ahvsxnkCGyee.root
# MYSQL_PASSWORD=GU0IOb0FU4xSQfhw
# MYSQL_DATABASE=sys
# MYSQL_SSL=true
