# Copy this file to backend/.env (the name must be exactly ".env"). Never commit .env.
# This file only holds PLACEHOLDERS - never put a real password in it.

# ---- A) Use while running migrate_to_aiven.py (the SOURCE is your LOCAL MySQL) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=customer_database

# ---- B) Use afterwards to run the site on your computer against Aiven ----
# (replace block A with this block; on Render these go in Environment, not in a file)
# MYSQL_HOST=mysql-27b6e81e-shilish-0a63.j.aivencloud.com
# MYSQL_PORT=24605
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=
# MYSQL_DATABASE=defaultdb
# MYSQL_SSL=true
