{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|auth/|health/|openapi.json|docs).*)",
      "destination": "/frontend/$1"
    }
  ]
}
