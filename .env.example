# Render & Local Environment Variables
# In Render: add these in Environment Variables tab
# Locally: copy this to backend/.env

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=4000
DB_NAME=customer_database
DB_SSL=true

# Or single connection URL (optional alternative to DB_* vars):
# DATABASE_URL=mysql+pymysql://user:password@host:port/database

# Required secret key for JWT authentication (minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Render proxy header trust (set true on Render)
TRUST_PROXY=true

# Optional CORS whitelist (comma-separated; defaults to allow all)
# ALLOWED_ORIGINS=https://myfrontend.vercel.app,https://customervault.onrender.com
